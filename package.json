{
  "name": "magic-file-box",
  "version": "1.0.7",
  "private": true,
  "description": "Offline, read-only file preview tool for Windows",
  "author": "magic file box",
  "license": "MIT",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && tsx scripts/icon.ts && tsx scripts/build-electron.ts && tsx scripts/associations.ts && vite build && tsx scripts/copy-assets.ts",
    "build:win": "npm run build && electron-builder --win nsis --x64 && npm run verify:release && npm run verify:update",
    "build:win:zip": "npm run build && electron-builder --win zip --x64 && npm run verify:release -- --zip",
    "build:win:all": "npm run build && electron-builder --win nsis zip --x64 && npm run verify:release -- --zip && npm run verify:update",
    "verify:release": "tsx scripts/verify-release.ts",
    "verify:install": "tsx scripts/verify-install.ts",
    "build:dir": "npm run build && electron-builder --win --dir --x64",
    "start": "electron .",
    "test:smoke": "npm test -- --suite all",
    "test": "tsx tests/run.ts",
    "test:fixtures": "tsx scripts/fixtures.ts",
    "test:package": "tsx tests/package.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:ui": "npm test -- --suite bench",
    "verify:update": "tsx scripts/verify-update.ts",
    "exclusive:key": "tsx scripts/exclusive-key.ts",
    "test:exclusive": "tsx tests/exclusive.ts"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@file-viewer/doc": "^3.0.3",
    "@types/css-tree": "3.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@web-ppt/core": "^0.4.5",
    "css-tree": "3.2.1",
    "docx-preview": "^0.3.6",
    "dompurify": "^3.4.15",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "js-yaml": "^4.3.2",
    "jszip": "^3.10.1",
    "katex": "^0.18.10",
    "marked": "^18.0.12",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "^6.3.289",
    "png-to-ico": "^3.0.2",
    "shiki": "4.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "local.preview.desktop",
    "productName": "magic file box",
    "directories": {
      "output": "outputs/release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/*.cjs",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "artifactName": "MagicFileBox-${version}-Windows-x64.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "MagicFileBox-Setup-${version}-x64.exe",
      "include": "electron-dist/associations.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Linn924",
      "repo": "magic-file-box",
      "releaseType": "release",
      "private": false
    }
  },
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Linn924/magic-file-box.git"
  }
}
