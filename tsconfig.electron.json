{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "electron/**/*.ts",
    "shared/**/*.ts",
    "src/types/**/*.d.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
